@article{ansari2006extraction,
  abstract = {The effect of temperature on the extraction behaviour of Am(III), Pu(IV) and U(VI) from nitric acid medium was studied employing N,N,N',N'-tetraoctyl diglycolamide (TODGA) in n-dodecane. Two-phase equilibrium constants (log K'ex) were calculated and compared with those of CMPO and DMDBTDMA. Thermodynamic parameters dG, dH and dS for the extraction of actinides by TODGA were also compared with those of CMPO and DMDBTDMA. The extraction processes of Am(III) and U(VI) are enthalpy driven whereas the entropy factor counteracts the extraction; in the case of Pu(IV) the extraction process is both enthalpy and entropy favoured. The role of the diluent on the loading of Nd(III) in 0.1 M TODGA was also investigated.},
  author = {Ansari, S. A. and Pathak, P. N. and Husain, M. and Prasad, A. K. and Parmar, V. S. and Manchanda, V. K.},
  doi = {10.1524/ract.2006.94.6.307},
  journal = {Radiochimica Acta},
