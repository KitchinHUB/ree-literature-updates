@article{middleton2023separation,
  abstract = {Feedstock matrix variables (aqueous Al, Fe, pH) were evaluated for their impact on Nd and Er recovery flux by supported liquid membrane separations. Absolute Fe and Al concentrations, not molar ratios, controlled REE mass transfer. Nd and Er permeability coefficients were most sensitive to Fe(III): the threshold Fe(III) concentration that reduced permeability was more than 100 times lower than the concentrations required for Al or Fe(II) to do so. Separations with excess Fe(III) produced no observable fouling at the membrane interface; the pH gradient across the membrane and the relative cation affinity for the chelator were the major drivers of mass transfer.},
  author = {Middleton, Andrew and Hsu-Kim, Heileen},
  doi = {10.1021/acsestengg.3c00060},
