@article{dong2021bridging,
  abstract = {Immobilizes lanmodulin on agarose microbeads by thiol-maleimide chemistry at 2.47 umol protein/mL for flow-through REE extraction. Column capacity 5.77 umol Nd/mL (2:1 Nd:LanM, against 3 equivalents in solution); binds Nd down to pH 2.4 and strips at pH 1.7 or below; ten adsorption/desorption cycles with no loss of capacity. Complete rejection of Mg, Al, Ca, Co, Ni, Cu and Zn. Separates a 50:50 Nd/Dy feed to 99.9\% purity on both products at \~76\% recovery each, needs two cycles for a 95:5 magnet-scrap ratio, and concentrates a Powder River Basin coal fly ash leachate from 0.043 to 88.2 mol\% total REE in one 0.94 mL column run.},
