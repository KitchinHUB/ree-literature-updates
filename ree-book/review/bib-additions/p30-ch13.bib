% attached, and that document contains nothing about TOPO at all. Those TOPO
% claims are unsourced and have been deleted, along with the TOPO row of the
% "Summary of Thermodynamic Trends" table. No replacement source was found.

@inproceedings{charbonnel2000thermodynamics,
  abstract = {In the frame of the French program SPIN, CEA has undertaken the development of the DIAMEX process. The study focuses on thermodynamic properties (dH, dG, dS) related to the extraction of lanthanide elements by malonamide, using microcalorimetric titration and the classical van't Hoff approach. For the lipophilic diamide DMDBTDMA in TPH, the extraction enthalpy determined by van't Hoff for trivalent La, Nd, Eu, Er, Yb and Am nitrates increases along the Ln(III) series, with dH = -35 kJ/mol for La(III) and -27 kJ/mol for Yb(III) from 3 mol/L HNO3; for Am(III) the value is -36 kJ/mol. Titration calorimetry on Nd(III) extraction from 2.5 mol/L NaNO3 gives comparable results. Aqueous-phase complexation of Ln(III) by the water-soluble diamide TEMA is endothermic.},
  address = {Avignon, France},
  author = {Charbonnel, M. C. and Flandin, J. L. and Presson, M. T. and Morel, J. P.},
  booktitle = {Atalante 2000: Scientific Research on the Back-End of the Fuel Cycle for the 21st Century},
  keywords = {microcalorimetry, DIAMEX, malonamide, DMDBTDMA, extraction enthalpy, lanthanides, americium},
  note = {Paper P3.29; report number INIS-FR-300; OSTI ID 20176396},
  pages = {1--4},
  title = {Thermodynamics Properties of Complexation and Extraction of {Ln(III)} by Diamides},
  url = {https://www.osti.gov/etdeweb/biblio/20176396},
  year = {2000}
}

@article{ansari2006extraction,
  abstract = {The effect of temperature on the extraction behaviour of Am(III), Pu(IV) and U(VI) from nitric acid medium was studied employing N,N,N',N'-tetraoctyl diglycolamide (TODGA) in n-dodecane. Two-phase equilibrium constants (log K'ex) were calculated and compared with those of CMPO and DMDBTDMA. Thermodynamic parameters dG, dH and dS for the extraction of actinides by TODGA were also compared with those of CMPO and DMDBTDMA. The extraction processes of Am(III) and U(VI) are enthalpy driven whereas the entropy factor counteracts the extraction; in the case of Pu(IV) the extraction process is both enthalpy and entropy favoured. The role of the diluent on the loading of Nd(III) in 0.1 M TODGA was also investigated.},
  author = {Ansari, S. A. and Pathak, P. N. and Husain, M. and Prasad, A. K. and Parmar, V. S. and Manchanda, V. K.},
  doi = {10.1524/ract.2006.94.6.307},
  journal = {Radiochimica Acta},
  keywords = {TODGA, diglycolamide, actinide partitioning, extraction thermodynamics, enthalpy-driven},
  number = {6-7},
  pages = {307--312},
  publisher = {Walter de Gruyter GmbH},
  title = {Extraction of Actinides Using {N,N,N',N'}-tetraoctyl Diglycolamide ({TODGA}): A Thermodynamic Study},
  url = {https://doi.org/10.1524/ract.2006.94.6.307},
  volume = {94},
  year = {2006}
}

@techreport{martin2010thermodynamics,
  abstract = {Summary of FY 2010 work on thermodynamics and kinetics of advanced separations systems under the DOE Fuel Cycle Research and Development program. Reports liquid-liquid distribution of lanthanides by HDEHP in n-dodecane from lactate/DTPA (TALSPEAK) solutions, and the first account of a direct calorimetric measurement of the heat of liquid-liquid partitioning of any transuranic element: two-phase isothermal titration calorimetry of Am(III) transfer from pH 3.2, 1.0 M NaNO3 into 0.2 M HDEHP in n-dodecane. The Am(III) dG, dH and dS values fall on the lanthanide trend lines at the position expected for Pm(III); the exothermic heat of complex formation is opposed by a negative entropy term arising from complex ordering and from rehydration of the three exchanged protons.},
  author = {Martin, Leigh R. and Zalupski, Peter R.},
  institution = {Idaho National Laboratory},
  keywords = {two-phase calorimetry, HDEHP, americium, TALSPEAK, ITC, transuranic},
  month = {September},
  note = {FCR\&D-SEPA-2010-000174},
  number = {INL/EXT-10-19986},
  title = {Thermodynamics and Kinetics of Advanced Separations Systems -- {FY} 2010 Summary Report},
  type = {Technical Report},
  url = {https://inldigitallibrary.inl.gov/sites/sti/sti/4781579.pdf},
  year = {2010}
}
