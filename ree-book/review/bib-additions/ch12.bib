@article{kosemutlu2020separation,
  abstract = {Micelle enhanced ultrafiltration (MEUF) with sodium dodecyl sulfate as the micellar sorbent was evaluated for separating rare earth elements from a synthetic coal ash leachate feedstock, followed by acidification and ferricyanide precipitation for surfactant recovery. Membrane rejection efficiencies of REEs were 97 percent for synthetic and 71 percent for real leachate under optimized operating conditions.},
  author = {Kose-Mutlu, Borte and Hsu-Kim, Heileen and Wiesner, Mark R.},
  doi = {10.1080/09593330.2020.1812732},
  journal = {Environmental Technology},
  keywords = {micelle enhanced ultrafiltration, SDS, coal ash leachate, rejection},
  number = {7},
  pages = {1013--1025},
  publisher = {Informa UK Limited},
  title = {Separation of Rare Earth Elements from Mixed-Metal Feedstocks by Micelle Enhanced Ultrafiltration with Sodium Dodecyl Sulfate},
  url = {https://doi.org/10.1080/09593330.2020.1812732},
  volume = {43},
  year = {2020}
}

@article{kosemutlu2018application,
  abstract = {Nanofiltration was evaluated as a step in recovering rare earth elements from coal combustion fly ash leachates, with pH adjustment and microfiltration as pre-treatment. The individual and combined effects of applied pressure (12-24 bar) and feed acidity (pH 1.5-3.5) on the rejection of six critical REEs and on permeate flux were mapped by response surface methodology and fed into a cost model; the optimum operating point was 12 bar and pH 3.5.},
  author = {Kose Mutlu, Borte and Cantoni, Beatrice and Turolla, Andrea and Antonelli, Manuela and Hsu-Kim, Heileen and Wiesner, Mark R.},
  doi = {10.1016/j.cej.2018.05.080},
  journal = {Chemical Engineering Journal},
  keywords = {nanofiltration, coal fly ash leachate, rejection, cost},
  pages = {309--317},
  publisher = {Elsevier BV},
  title = {Application of Nanofiltration for Rare Earth Elements Recovery from Coal Fly Ash Leachate: Performance and Cost Evaluation},
  url = {https://doi.org/10.1016/j.cej.2018.05.080},
  volume = {349},
  year = {2018}
}

@article{lopez2018application,
  abstract = {Nanofiltration of acid mine drainage containing rare earth elements. The semi-aromatic polyamide membrane NF270 was tested on sulphuric model solutions (pH 1.5-3.0) containing Ca, Al and Zn, then with REE added. NF270 showed high rejections for metallic ions while allowing acid permeation; ion rejection data were fitted with a solution-diffusion model with reactive transport. Membrane stability was assessed by comparing a virgin membrane with one aged for four weeks in 1 M sulphuric acid, with ATR-FTIR, AFM and XPS characterisation.},
  author = {L\'opez, J. and Reig, M. and Gibert, O. and Torres, E. and Ayora, C. and Cortina, J. L.},
  doi = {10.1016/j.desal.2017.12.033},
  journal = {Desalination},
  keywords = {nanofiltration, NF270, acid mine drainage, membrane stability},
  pages = {33--44},
  publisher = {Elsevier BV},
  title = {Application of Nanofiltration for Acidic Waters Containing Rare Earth Elements: Influence of Transition Elements, Acidity and Membrane Stability},
  url = {https://doi.org/10.1016/j.desal.2017.12.033},
  volume = {430},
  year = {2018}
}

